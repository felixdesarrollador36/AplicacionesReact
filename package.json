{
  "name": "sistemagrabacion",
  "version": "1.0.0",
  "description": "Desktop screen and audio recording application for Teams and Google Meet",
  "main": "dist/electron/main/index.js",
  "homepage": "./",
  "author": "Your Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron dist/electron/main/index.js",
    "build": "npm run build:electron && npm run build:react",
    "build:react": "vite build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "preview": "vite preview",
    "package": "electron-builder",
    "package:simple": "electron-packager . SistemaGrabacion --platform=win32 --arch=x64 --out=release --overwrite --ignore=src/components --ignore=src/pages",
    "test": "vitest"
  },
  "dependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.368.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-packager": "^17.1.2",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.32",
    "postcss-load-config": "^4.0.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "wait-on": "^7.1.0"
  },
  "build": {
    "appId": "com.sistemagrabacion.app",
    "productName": "Sistema de Grabación",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
